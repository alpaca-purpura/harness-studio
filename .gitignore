# Node / UI
node_modules/
# dist se ignora POR CONTENIDO (no el dir): web/dist/.gitkeep viaja commiteado para que
# el go:embed de la SPA (embed_webdist.go) compile siempre; el bundle real lo llena.
web/dist/*
!web/dist/.gitkeep
.next/
*.tsbuildinfo

# Go
bin/
# …pero los fixtures de test NO son binarios de build: se versionan.
!**/testdata/bin/
!**/testdata/bin/**
*.exe
/arnesia


# Tauri sidecar (daemon binario, se compila con `go build -o web/src-tauri/binaries/...`)
web/src-tauri/binaries/arnesia-*
web/src-tauri/target/
web/src-tauri/gen/

# Local
.DS_Store
*.log
.env
.env.*
mockups/.shots/

# Artefactos de build del instalador de escritorio (make installer): binarios versionados
# LOCALMENTE en instaladores/vX.Y.Z/ (~90M por versión) — al repo va el BUMP de los 3
# manifiestos, jamás los binarios (docs/architecture/conventions/versionado.md).
instaladores/

# Config local del editor (vault Obsidian del operador)
.obsidian/

# Sesiones efímeras del MCP playwright (logs/snapshots de debug)
.playwright-mcp/

# Cockpit vendored (tools/cockpit) — al repo van las FUENTES, jamás los productos de
# build: el binario (~11M), la UI compilada que se le embebe, y las deps/caché de Next.
tools/cockpit/go/cockpit
tools/cockpit/go/cockpit.exe
tools/cockpit/go/ui/
tools/cockpit/ui/node_modules/
tools/cockpit/ui/.next/
tools/cockpit/ui/out/
tools/cockpit/.cockpit-local/
