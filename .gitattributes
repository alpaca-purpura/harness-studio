# Line endings normalizados — el repo se autora con LF; Windows checkout incluido.
# Sin esto, core.autocrlf=true convierte los .sh a CRLF en el working tree y Git Bash
# falla con «\r: command not found» (estado.sh, bundle.sh, hooks de lefthook).
* text=auto eol=lf

# Siempre LF (scripts y fuentes que herramientas Unix/Go/Node leen tal cual)
*.sh text eol=lf
*.py text eol=lf
Makefile text eol=lf
*.go text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.rs text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.toml text eol=lf

# PowerShell: texto, EOL libre (PowerShell acepta ambos)
*.ps1 text

# Binarios — jamás normalizar
*.png -text
*.ico -text
*.icns -text
*.woff2 -text
*.db -text
*.jsonl -text
