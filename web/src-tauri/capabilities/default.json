{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability base del shell ArnesIA: ventana 'main' + spawn del daemon Go como sidecar + selector nativo de carpeta.",
	"windows": ["main"],
	"remote": {
		"urls": ["http://127.0.0.1:4200/*"]
	},
	"permissions": [
		"core:default",
		{
			"identifier": "shell:allow-execute",
			"allow": [
				{ "name": "binaries/arnesia-daemon", "sidecar": true, "args": ["serve"] }
			]
		},
		"dialog:allow-open"
	]
}
