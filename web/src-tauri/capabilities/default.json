{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability base del shell ArnesIA: ventana 'main' + spawn del daemon Go como sidecar.",
	"windows": ["main"],
	"permissions": [
		"core:default",
		{
			"identifier": "shell:allow-execute",
			"allow": [
				{ "name": "binaries/arnesia-daemon", "sidecar": true, "args": ["serve"] }
			]
		}
	]
}
