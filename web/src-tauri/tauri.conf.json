{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "ArnesIA",
	"version": "0.2.16",
	"identifier": "lat.alpacapurpura.arnesia",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "pnpm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["arnesia"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"externalBin": ["binaries/arnesia-daemon"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
