{
  "name": "arnesia-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "_comment": "SPA de ArnesIA (Vite+React, embebida vía go:embed; envuelta por Tauri 2). Topología FSD-lite (arch/boundaries/fe-topologia-fsd.md). Versiones = rango razonable a jul-2026; verificar/lock al primer `npm install`.",
  "engines": { "node": ">=20.16" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tokens:build": "style-dictionary build --config style-dictionary.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "depcruise": "depcruise src --config .dependency-cruiser.js",
    "fsd": "steiger src",
    "stylelint": "stylelint \"src/**/*.css\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run depcruise && npm run fsd && npm run stylelint"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0",
    "@xyflow/react": "^12.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-vitest": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tsconfig/strictest": "^2.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/browser": "^2.1.0",
    "dependency-cruiser": "^16.0.0",
    "playwright": "^1.48.0",
    "steiger": "^0.5.0",
    "storybook": "^10.0.0",
    "style-dictionary": "^5.0.0",
    "stylelint": "^16.10.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
