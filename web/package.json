{
	"name": "arnesia-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"_comment": "SPA de ArnesIA (Vite+React, embebida vía go:embed; envuelta por Tauri 2). Topología FSD-lite (arch/boundaries/fe-topologia-fsd.md). Versiones = rango razonable a jul-2026; verificar/lock al primer `npm install`.",
	"engines": {
		"node": ">=20.16"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"tokens:build": "style-dictionary build --config style-dictionary.config.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"depcruise": "depcruise src --config .dependency-cruiser.js",
		"fsd": "steiger src",
		"stylelint": "stylelint \"src/**/*.css\"",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test": "vitest run",
		"verify": "npm run typecheck && npm run lint && npm run depcruise && npm run fsd && npm run stylelint"
	},
	"dependencies": {
		"@base-ui-components/react": "1.0.0-rc.0",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-shell": "^2.3.5",
		"@xyflow/react": "^12.11.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.23.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tailwind-merge": "^3.6.0",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@tauri-apps/cli": "^2.11.4",
		"@storybook/addon-a11y": "^10.4.6",
		"@storybook/addon-vitest": "^10.4.6",
		"@storybook/react-vite": "^10.4.6",
		"@tailwindcss/vite": "^4.3.2",
		"@tsconfig/strictest": "^2.0.8",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/browser": "^4.1.9",
		"dependency-cruiser": "^18.0.0",
		"playwright": "^1.61.1",
		"steiger": "^0.5.13",
		"storybook": "^10.4.6",
		"style-dictionary": "^5.5.0",
		"stylelint": "^17.14.0",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"vite": "^8.1.3",
		"vitest": "^4.1.9"
	}
}
